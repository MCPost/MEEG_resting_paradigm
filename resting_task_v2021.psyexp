    <LoopInitiator loopType="TrialHandler" name="loop_artifact_recording">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('slide', 0), ('text', 'Im Folgenden würden wir Sie bitten sobald Sie auf dem Bildschirm aufgefordert werden \n\n &lt;c=#000000&gt;mit den Augen zu rollen&lt;/c&gt; \n\n Fahren Sie damit fort bis Sie eine neue Anweisungen erhalten. \n\n'), ('short', 'Augen rollen')]), OrderedDict([('slide', 1), ('text', 'Im Folgenden würden wir Sie bitten sobald Sie auf dem Bildschirm aufgefordert werden \n\n &lt;c=#000000&gt;mit den Augen zu blinzeln&lt;/c&gt; \n\n Fahren Sie damit fort bis Sie eine neue Anweisungen erhalten. \n\n'), ('short', 'Blinzeln')]), OrderedDict([('slide', 2), ('text', 'Im Folgenden würden wir Sie bitten sobald Sie auf dem Bildschirm aufgefordert werden \n\n &lt;c=#000000&gt;die Augen von Links nach Rechts hin und her zu bewegen&lt;/c&gt; \n\n Fahren Sie damit fort bis Sie eine neue Anweisungen erhalten. \n\n'), ('short', 'Augen hin und her bewegen')]), OrderedDict([('slide', 3), ('text', 'Im Folgenden würden wir Sie bitten sobald Sie auf dem Bildschirm aufgefordert werden \n\n &lt;c=#000000&gt;den Kiefer anzuspannend und mit den Zähnen zu knirschen&lt;/c&gt; \n\n Fahren Sie damit fort bis Sie eine neue Anweisungen erhalten. \n\n'), ('short', 'Kiefer anspannen und knirschen')]), OrderedDict([('slide', 4), ('text', 'Im Folgenden würden wir Sie bitten sobald Sie auf dem Bildschirm aufgefordert werden \n\n &lt;c=#000000&gt;mehrfach hintereinander zu schlucken&lt;/c&gt; \n\n Fahren Sie damit fort bis Sie eine neue Anweisungen erhalten. \n\n'), ('short', 'Schlucken')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="instructions\artifact_instruction.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
