    <LoopInitiator loopType="TrialHandler" name="loop_eyesclosed_instruction">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('slide', np.int64(0)), ('text', 'Vielen Dank, für Ihre Teilnahme! \n\nDamit die Messung ein Erfolg wird, benötigen wir Ihre Mithilfe:\n\nBitte sitzen Sie ruhig und entspannt und &lt;c=#000000&gt;vermeiden Sie unnötige Bewegungen &lt;/c&gt;sowie häufiges &lt;c=#000000&gt;Blinzeln&lt;/c&gt;. Lassen Sie automatisches Blinzeln jedoch zu.\n\n Wenn es unbequem wird, richten Sie sich kurz neu aus, um wieder eine ruhige Position zu finden. \n\nFalls Sie fragen haben, wenden Sie sich bitte an die Studienleitung.\n\nSonst können Sie mit der blauen Taste fortfahren.')]), OrderedDict([('slide', np.int64(1)), ('text', 'Im folgenden nehmen wir eine 5-minütige Ruhemessung vor.\n\nSchauen Sie bitte dabei auf das Kreuz in der Mitte des Bildschirms. \nLassen Sie dabei Ihre Gedanken ziehen und denken Sie an nichts Bestimmtes.\n\nFalls Sie fragen haben, wenden Sie sich bitte an die Studienleitung.\n\nSonst können Sie mit der blauen Taste fortfahren.')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="instructions/eyesclosed_instruction.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="loop_eyesclosed_instruction" valType="code"/>
